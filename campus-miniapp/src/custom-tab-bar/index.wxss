:host { position:relative; z-index:1000; }
.glass-dock {
  position:fixed; z-index:1000; left:32rpx; right:32rpx;
  bottom:20rpx; bottom:calc(16rpx + env(safe-area-inset-bottom));
  max-width:520px; margin:0 auto; padding:10rpx;
  border:1px solid rgba(255,255,255,.9); border-radius:80rpx;
  background:rgba(255,252,249,.72);
  background-image:linear-gradient(145deg,rgba(255,255,255,.28),rgba(255,248,243,.04));
  -webkit-backdrop-filter:blur(22px) saturate(155%);
  backdrop-filter:blur(22px) saturate(155%);
  box-shadow:0 12rpx 42rpx rgba(70,38,35,.12),0 2rpx 8rpx rgba(70,38,35,.04),inset 0 1px 0 rgba(255,255,255,.95);
  box-sizing:border-box;
}
.glass-track { display:flex; position:relative; height:112rpx; min-height:56px; border-radius:64rpx; }
.glass-lens {
  position:absolute; left:0; top:0; width:25%; height:100%; box-sizing:border-box;
  border:1px solid rgba(255,255,255,.9); border-radius:64rpx;
  background:linear-gradient(145deg,rgba(255,255,255,.94),rgba(239,219,218,.68));
  box-shadow:0 3rpx 12rpx rgba(113,62,61,.07),inset 0 1px 0 #fff;
  transition:transform 280ms cubic-bezier(.22,.8,.24,1);
  pointer-events:none;
}
.dock-tab {
  flex:1; width:25%; position:relative; z-index:1; display:flex; flex-direction:column;
  align-items:center; justify-content:center; gap:4rpx; min-height:56px;
  padding:8rpx 0; margin:0; border:0; border-radius:64rpx; background:transparent;
  font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;
  color:#706763; line-height:1.3; box-sizing:border-box;
  transition:color 140ms,opacity 140ms;
}
.dock-tab::after { border:0; }
.dock-icon { width:44rpx; height:44rpx; min-width:22px; min-height:22px; pointer-events:none; }
.dock-label { font-size:22rpx; font-weight:500; pointer-events:none; }
.is-selected { color:#8d2f38; }
.is-selected .dock-label { font-weight:650; }
.dock-pressed { opacity:.7; }
.dock-tab:focus-visible { outline:2px solid #8d2f38; outline-offset:-3px; }
.is-dragging .glass-lens { transition:none; box-shadow:0 4rpx 18rpx rgba(113,62,61,.13),inset 0 1px 0 #fff; }
@media(prefers-reduced-motion:reduce) { .glass-lens,.dock-tab { transition:none; } }
